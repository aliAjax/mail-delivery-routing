{
  "mode": "service",
  "start": "bin=$(mktemp -t mail-delivery-routing-smoke) && go build -o $bin ./cmd/server && exec $bin",
  "workdir": ".",
  "env": {
    "CGO_ENABLED": "0",
    "MAIL_HTTP_ADDR": "127.0.0.1:38089",
    "MAIL_SMTP_ADDR": "127.0.0.1:3525",
    "MAIL_GRPC_ADDR": "127.0.0.1:39089"
  },
  "ready_url": "http://127.0.0.1:38089/healthz",
  "ready_status": [
    200
  ],
  "startup_timeout": 20
}
